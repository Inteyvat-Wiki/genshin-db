				"points": []
			},
			"dialogs": [
				{
					"id": 751111401,
					"content": "Sim, isso é meu. Alguém dos Filhos dos Ecos queria comprar tintas, mas não conseguia me dizer o que queria exatamente, mesmo que fosse para salvar sua própria vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "Então foi por isso que enviei um pacote com várias pequenas garrafas de tintas dentro — para que ele possa vir comprar da próxima vez com mais certeza do que quer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Vou enviar isso de novo — melhor do que ter ele de volta aqui com suas referências de pedidos ridículas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ah, certo. Isso é para você. Obrigada por me devolver esse pacote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
