			"dialogs": [
				{
					"id": 751110101,
					"content": "Eu peguei isso mais cedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Hã, sério? Será que algum idiota perdeu isso no meio do caminho de novo? Deixe-me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
