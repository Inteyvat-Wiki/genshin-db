			"dialogs": [
				{
					"id": 150240101,
					"content": "Algo está se escondendo atrás daquela estátua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240102,
					"content": "Aw, é um bebê Iktomissauro. Tão fofo... mas, por que ele está encarando a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240103,
					"content": "#{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240104,
					"content": "(Que lugar é esse...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240106,
					"content": "(Quem é você...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Urg... Por quanto tempo Paimon apagou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "Paimon olhou nos olhos daquele bebê Iktomissauro por tipo, um segundo, e então ela do nada foi puxada para um lugar estranho com um Iktomissauro imeeeenso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240110,
					"content": "É, idem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "Alguma ideia do que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240112,
					"content": "#...{NICKNAME}? Ei, o que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240113,
					"content": "Está ali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "Veja! É aquele bebê Iktomissauro — parece que ele quer que a gente siga ele. O lado aventureiro de Paimon diz que temos que ir ver até onde isso vai dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240116,
					"content": "Estou dentro! Vamos nessa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "#Estamos sendo chamad{M#o}{F#a}s...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
		{
