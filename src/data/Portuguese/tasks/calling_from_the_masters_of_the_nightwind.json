			"dialogs": [
				{
					"id": 150240901,
					"content": "Tem tantos pergaminhos tecidos aqui. Paimon lembra de ver alguns antes em outras tribos. Parece que eles servem para registrar eventos históricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240902,
					"content": "Esse aqui se destaca do resto. Para começar, é o maior de todos. Qual será a história que ele conta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240903,
					"content": "As cores também são bem diferenciadas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240904
					]
				},
				{
					"id": 150240904,
					"content": "É, tem razão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240905,
					"content": "Ali, algo acabou de piscar! Viajante, você viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240906,
					"content": "Talvez seja assim que a gente sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "...Vendo coisas que não víamos antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
					"id": 150240908,
					"content": "Aaah, certo! Paimon tá contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
