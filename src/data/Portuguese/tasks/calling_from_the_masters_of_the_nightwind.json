			},
			"dialogs": [
				{
					"id": 150240301,
					"content": "Olá, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240303,
					"content": "Tá, ele provavelmente não entende nada do que estamos falando... Não parece que nada está funcionando naquela cabecinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240304,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240305,
					"content": "Ops, desculpa! Não quis ofender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "Você aí — você ousa desrespeitar nosso ancião!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "#Oh, você quer dizer... Entendo, entendo. Desculpa, foi mal. Aparentemente, você veio aqui por convite, no caso, é minha obrigação te fazer sentir acolhid{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Acho que devo dar algumas instruções. Sou Caholom, um dos sacerdotes da nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "E esse é nosso Iktomissauro Ancião, o Grande Tlapopoctiztetl. Um verdadeiro totem vivo entre os Mestres do Vento Noturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "Uau, que nomezinho hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "Na verdade, normalmente só chamamos de \"Ancião Tlapo\", para ser mais prático. Você pode fazer o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "#Fomos convidad{M#o}{F#a}s até aqui de uma forma bem... peculiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Ah, imagino que você está se referindo à habilidade única de nosso ancião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "O Ancião Tlapo está vivo há vários séculos e possui segredos que até mesmo nós, sacerdotes, não sabemos explicar, então sua reação é totalmente natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "Mas uma coisa que posso dizer com certeza é que o Ancião Tlapo deu a vocês uma tarefa muito importante. Por esse motivo, eu gostaria de te pedir para passar por um teste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "Que tipo de tarefa? E que tipo de teste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Se estiver tudo bem por você, te levarei para ver nosso chefe. Ele saberia responder sua dúvida muito melhor do que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Uh... tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Muito bem, então, por favor, sigam-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Você pode usar esse pergaminho para ir diretamente até o Altar de Obsidiana, onde o chefe está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "Não se preocupe, é apenas uma das muitas habilidades místicas de nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
