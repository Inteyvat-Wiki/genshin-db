					{
						"sceneId": 3,
						"position": [
							-1644.502,
							15.092,
							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Uau, o que foi isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "Um dos deveres de rotina de um sacerdote. Tentamos entrar em contato com o espírito de nossos ancestrais para buscar epifanias e revelações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "O chefe está logo ali. Por favor, espere aqui enquanto falo com ele — não vai demorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Bem, os Mestres do Vento Noturno certamente estão fazendo jus à sua reputação de misteriosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Muito bem, eu contei ao chefe o motivo de estarmos aqui e agora você pode falar com ele. Por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "#Então, vocês {M#dois}{F#duas} foram {M#os escolhidos}{F#as escolhidas}? Sou chefe Biram. Bem-vind{M#o}{F#a}s, e agradeço pela sua paciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "Tão alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Bem fora do normal. Sim, estou ciente. Mas, posso te garantir, não precisa ficar alarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "Oh — não, é claro que não! Desculpe, Paimon só reagiu sem pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "#Que papo é esse sobre termos sido \"escolhid{M#o}{F#a}s\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "#Ah, sim. Caholom me contou sobre isso. Como forasteir{M#o}{F#a}s de nossa tribo, essa é provavelmente a primeira vez que você ouviu falar de algo assim. Tenho certeza que tudo parece bem confuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "#Ao longo de nossa história, apenas membros do Mestres do Vento Noturno foram escolhidos para fazer essas tarefas. Essa é a primeira vez que {M#um forasteiro foi escolhido}{F#uma forasteira foi escolhida}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Permita-me explicar. Nossa tribo tem uma antiga tradição de registrar a história por meio de pergaminhos tecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "E não apenas nossa própria história. Registramos as lendas e feitos heroicos de todas as outras tribos também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "É uma tradição que temos há vários séculos. Consideramos isso uma obrigação solene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Porém, quando um grande evento ocorre que afeta toda Natlan, registramos isso em um tipo diferente de pergaminho usado para esse exato propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "E esses pergaminhos só podem ser tecidos por alguém que o Ancião Iktomissauro escolheu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Quando o Ancião Iktomissauro sente uma grande mudança nas Linhas Ley, ele envia uma declaração formal para nomear um criador para esse pergaminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "Então, você quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "O Ancião Tlapo sentiu uma mudança nas Linhas Ley um tempo atrás, mas ainda não havia apontado o tecelão de pergaminho... até você chegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "Tá, mas... Só para você saber, não sabemos absolutamente nada sobre tecer pergaminhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "Na verdade, isso não me surpreende nem um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "Nos duzentos anos que o Ancião Tlapo está nessa posição, nenhum dos escolhidos por ele eram tecelões de pergaminhos experientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "Isso quer dizer que duzentos anos de grandes eventos históricos não foram registrados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "Não, todos enviaram seus pergaminhos a tempo. Porém, cada um deles disse que não foi trabalho deles, mas uma \"dádiva dos espíritos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Caramba... essa tribo fica cada vez mais misteriosa por segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Sim, bem... essa é a parte que me incomoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "A noção de que temos que depender de coisas esotéricas como \"dádivas dos espíritos\" para registrar eventos históricos de tamanha importância... é inquietante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Hmm... Que surpresa ouvir isso, vindo do chefe dessa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Posso imaginar. Você provavelmente vê os Mestres do Vento Noturno como um povo envolto em mistério, que nos orgulhamos de nossas práticas arcanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "Mas eu sou uma exceção. Posso ser o chefe, mas em relação a nossas tradições, eu sou, na verdade, a favor de mudança e reforma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Dediquei minhas energias a decifrar os muitos mistérios de nossa tribo. Ao fazer isso, espero estabelecer regras mais claras que ajudarão a sustentar nossas tradições no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Uau, parece ótimo! Então você desvendou o mistério da \"dádiva dos espíritos\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "Infelizmente não... É algo que estou investigando há muito tempo, mas ainda não descobri ao que essa \"dádiva\" realmente se refere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Apenas um punhado de eventos ao longo dos anos foi registrado nesses pergaminhos especiais, com décadas entre eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "E até o momento que o próximo tecelão de pergaminhos seja escolhido, minha posição como chefe terá se esgotado há muito tempo. Não estarei em posição para investigar isso mais a fundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "Então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Então, embora eu ainda não tenha chegado ao fundo da questão, fiz algum progresso. Mas a única forma que posso desenvolver mais as minhas teorias é com a cooperação dos escolhidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "E é por isso que você quer que a gente faça esse teste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Exatamente. Não é nada para se preocupar — apenas uma forma de validar minhas suspeitas. Não deve demorar, nem te colocará em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "Tudo bem. Então, o que isso envolve, mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "Posso explicar tudo detalhadamente quando chegarmos à área do teste. Mas, primeiro, por favor, espere um momento enquanto eu tiro o Manto de Proteção da Alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Essa é uma relíquia cultural muito importante, passada por gerações de chefes. Só deve ser usada durante certas cerimônias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram remove seu manto e cuidadosamente entrega para um sacerdote guardá-lo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Por favor, siga-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "Vê esse pergaminho? Se você o tocar, entrará em um espaço oculto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "O teste de hoje é bem simples, encontre uma forma de escapar desse espaço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "É isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "Posso te garantir, não é tão fácil quanto parece. Se você não conseguir encontrar uma forma de sair, obviamente irei intervir para te trazer de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Mas, assim não estaremos nem perto de resolver esse mistério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Vamos tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Ótimo. Apenas toque no pergaminho para começar o teste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
			"id": 1502406,
