			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1616.678,
							172.831,
							9686.546
						],
						"pointId": 9998
					}
				]
			},
			"dialogs": [
				{
					"id": 150240201,
					"content": "Me pergunto se temos permissão de estar aqui... Oh. A porta se abriu por conta própria. Acho que isso é um \"sim\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240202,
					"content": "Aw! É o Iktomissauro de antes, ele realmente está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240203,
					"content": "Foi ele quem nos chamou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240204
					]
				},
				{
					"id": 150240204,
					"content": "Então vamos ir nos apresentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
