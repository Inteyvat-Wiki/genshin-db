				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Meu querido discípulo e eu treinamos as artes marciais desde a infância. Nossa busca era combater as forças do mal e proteger tudo o que é sagrado neste mundo. Mas esta não foi uma tarefa fácil sem a ajuda de uma Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710100102,
					"content": "Nós dois procuramos refúgio aqui para treinarmos mais e para buscarmos as Visões que tanto desejávamos. Erguemos este monumento como prova de nossos esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Tesouro das Ruínas"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Mas agora que meu querido discípulo obteve sua Visão, em vez de lutar contra monstros, ele me perguntou: \"Os monstros são verdadeiramente maus por natureza?\" Então eu lhe respondi: \"Eles causam estragos em todo o mundo, e pessoas inocentes são as que devem sofrer as consequências. Isso é tão insuficientemente perverso a ponto de você conservar sua lâmina?\" Acredito que um excesso de meditação fritou seu cérebro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710100202,
					"content": "Bem, eu ainda pretendo enfrentar estes monstros - mesmo que isso signifique fazê-lo sem a ajuda dele, e mesmo que isso signifique fazê-lo sem uma Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Tesouro das Ruínas"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101007",
							"3"
						],
						"stepId": 7101007,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Os monstros são a ruína de tudo aquilo pelo que vale a pena viver neste mundo. Aqueles de nós que são mais habilidosos com a lâmina, são obrigados a caçá-los e extingui-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710100302,
					"content": "Monstros são malignos! Não merecem nada mais do que o abate impiedoso que terão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Tesouro das Ruínas"
				}
			]
		},
