			},
			"dialogs": [
				{
					"id": 700740801,
					"content": "Gruru Gruru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Pombo"
				},
				{
					"id": 700740802,
					"content": "Peguei! As penas estão no saco, repito, as penas estão no saco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Finalmente! Essa tarefa é bem mais difícil do que a Paimon imaginava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Só falta mais um ingrediente... \"Caldo medicinal preparado em um grande caldeirão\". Isso tem que ser no Vale de Dadaupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "Vou para lá agora mesmo. Sigam assim que puderem, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Ei, espera a...! Aff, que empolgação... Esse cara saiu correndo mais rápido do que um bando de pombos assustados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Clássica mentalidade de \"livre como o vento\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "...Esse velho beberrão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "Hã? Quem está aí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "Diona? O que você está fazendo aqui? E por que estava se escondendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "Eu... Eu só vim pegar umas frutas, juro! Só não esperava encontrar aquele traste até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Ele tem me importunado sem parar ultimamente, tentando me convencer a fazer uma bebida para ele de novo. Fiquei tão farta disso que tenho evitado ele sempre que posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "Então qual é a história por trás dessa bebida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Então, você sabe que ele voltou recentemente com parte da força expedicionária, né? Pois é, adivinha? Praticamente a primeira coisa que fizeram foi passar na Cauda do Gato para comemorar com \"um ou dois drinques\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "Sério? Paimon achou que eles teriam ficado na sede dos Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Eu sempre imaginei que o Varka fosse mais do tipo que gostava do Presentes dos Anjos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Ugh... É por isso que eu disse \"praticamente\". Eles fizeram tudo isso e mais! A Cauda do Gato foi a terceira rodada de uma maratona de taverna pela cidade inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "...E a Paimon aposta que eles vão fazer tudo de novo da próxima vez que outro grupo de tropas voltar para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "Sem dúvida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "Enfim, resumindo a história, eu não aguentava mais nem por um segundo olhar para aqueles velhos gambás bêbados! Então eu fiz disso a minha missão, misturar para eles as bebidas mais nojentas e enjoativas de toda Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Mas, Diona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "É... Por isso eu tentei fazer o Príncipe preparar as bebidas. Ugh, se ao menos aqueles bêbados não tivessem começado a mexer com o Príncipe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "...No fim, o Príncipe saiu correndo antes de conseguir terminar. Pelo menos ele deu um beliscão bem grande naquele velho beberrão antes de ir embora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(Ah! Então foi assim que o Varka conseguiu a cicatriz...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "Eu estava lá, me aventurando em um Domí{RUBY#[D]taverna}nio profundo e sombrio, batalhando contra alguns dos mons{RUBY#[D]O Príncipe}tros mais ferozes e cruéis que já vi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "Enfim, estava bem ali na minha frente, a só um passo de estar completo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "...Então você mesmo deu os retoques finais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "É.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Só por curiosidade, deixa eu perguntar mais uma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Hum... Algumas lascas de madeira que eu vi nas roupas dos Cavaleiros, algumas penas de pombo que peguei na floresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "...E um pouco da sopa de ervas de hilichurl que eu estava planejando transformar num remédio para curar bebedeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "Espera um pouco... Você disse que isso aconteceu pouco depois de o Varka voltar pela primeira vez, não foi? Então isso quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "Ninguém contou para ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Ah não, isso pode dar ruim! Temos que ir parar ele antes que seja tarde demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "...Que só a própria Diona consegue fazer uma receita tão horrível ficar gostosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "O que você colocou ali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Você não conseguiria fazer uma bebida ruim nem se tentasse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Aposto que ele mal consegue esperar as bebidas começarem a rolar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
			"id": 7007409,
