			"dialogs": [
				{
					"id": 700740401,
					"content": "Incrível! Então É ASSIM que se faz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "Por que Paimon sente como se já tivesse ouvido essa reação umas cem vezes antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Hmm... Isso aí! O formato, a textura, a qualidade... brilhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "Como você consegue diferenciar um pedaço de madeira do outro é algo que Paimon nunca vai entender... Tanto faz, desde que você esteja feliz. Próximo, as \"penas de pombo derramadas de alegria\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
