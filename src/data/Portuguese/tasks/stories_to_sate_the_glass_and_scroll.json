			"dialogs": [
				{
					"id": 700740501,
					"content": "Ei! Você espantou todos os pombos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "...G-Grande Mestre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Ei, mas se não é o pequeno Timmie! Cresceu bastante, não foi? Tem se alimentado bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "S-Sim, senhor! Eu sempre me lembro do que você me disse, que eu tenho que comer bem e me exercitar bastante se eu quiser crescer grande e forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "A atitude dessa criança...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Bom, acho que esse é o efeito Varka... Sinceramente, Paimon ficaria chocada se houvesse uma única criança nessa cidade que não admirasse nossa \"lenda viva\" aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Desculpa por espantar seus pombos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Eu ia perguntar... Tem algum jeito de se aproximar dos pombos sem assustá-los... e ao mesmo tempo mantê-los felizes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Hmm... Para falar a verdade, eu geralmente só chego perto deles em silêncio e espalho um pouco de ração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "Pronto, é isso! Ei, você tem ração extra aí agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Eu tenho bastante, mas... Grande Mestre... Ahm... O que você está planejando fazer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Não se preocupe, amiguinho, só precisamos pegar emprestada uma pena ou duas... Palavra de honra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ah... Tudo bem, então, sem problema! E obrigado, Grande Mestre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "Mudou num piscar de olhos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
