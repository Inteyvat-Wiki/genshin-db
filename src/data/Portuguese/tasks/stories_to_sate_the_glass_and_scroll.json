			"dialogs": [
				{
					"id": 700740201,
					"content": "Então é aqui que vamos conseguir essas \"lascas de madeira atingidas por cavaleiros\", é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "#Ah! Grande Mestre! Cavaleir{F#a}{M#o} Honorável! Vocês vieram treinar hoje também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Bom, talvez não no sentido tradicional... Mas estamos aqui para alcançar um objetivo, então acho que isso também conta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "Vocês já são tão habilidosos e ainda assim buscam a perfeição... Por favor, treinem como quiserem! Eu vou ficar aqui do lado, fazendo anotações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
