			"dialogs": [
				{
					"id": 700740101,
					"content": "Sabe, como foi Varka que fez o acordo com a Sociedade das Feiticeiras, como é que nunca descobrimos qual foi a tarefa que elas deram para ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Vamos ver... Varka, Varka... Ué, por que está em branco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Por que não vamos perguntar para ele pessoalmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Boa ideia... Bem, do jeito que ele é, é melhor começarmos verificando todas as tavernas e restaurantes locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "...Ainda não está aqui, é? Parece que vou ter que descobrir isso sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "Falando no diabo... né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Ei, Varka! Queríamos perguntar sobre a sua \"tarefa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "Ah, olá, Cavaleiro Honorário e Paimon! Minha \"tarefa\"...? Do que se trata isso tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "A Sociedade das Feiticeiras deu tarefas para todo mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Agora que você falou, tenho quase certeza de que a Alice me disse algo sobre isso... Eu acho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "Você acha? O acordo que você fez com elas é o porquê essas tarefas sequer existem! Urgh, enfim, por que a sua tá em branco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "...Se eu tivesse que chutar, provavelmente porque seria demais para aquele livrinho deles aguentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Agora você chamou minha atenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "A minha tarefa... é fazer o melhor vinho que Teyvat já viu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "...Como isso é \"demais\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Confie em mim, isso é coisa séria... Está vendo esta nova cicatriz no meu braço? Foi o preço que paguei só para conseguir a receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "Eu estava lá, me aventurando em um Domínio profundo e sombrio, batalhando contra alguns dos monstros mais ferozes e cruéis que já vi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Sério...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "#Agora só faltam três ingredientes especiais para terminar isso! Cavaleir{F#a}{M#o} Honorável, Paimon, vocês poderiam me dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Tudo bem, por que não...? Já que são só três coisas, a Paimon vai fingir que acredita na sua história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Certo! Hehe... Então, ainda precisamos de \"lascas de madeira atingidas por cavaleiros\", \"penas de pombo soltas de alegria\" e \"caldo medicinal preparado em um grande caldeirão\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Espera aí... A gente não ia fazer \"vinho\"? Isso está parecendo algum tipo de poção super suspeita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Hmm, bem observado... Bom, afinal, quem mandou isso são um bando de Bruxas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Estamos seguindo a receita à risca, então os três ingredientes precisam atender às exigências deles. Vamos lá, vamos começar com essas lascas de madeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "De quanto estamos falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "Mas a sua parece estar em branco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
