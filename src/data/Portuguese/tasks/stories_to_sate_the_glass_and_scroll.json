						],
						"pointId": 15600
					}
				]
			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "Inacreditável... Desde quando hilichurls são tão receptivos à razão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "Ella! Você não viu o Varka por aqui, viu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Na verdade, vi sim. Agora há pouco, ele foi lá pegar emprestado um \"caldeirão grande\" com os hilichurls... e olha só: eles entregaram assim que viram ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "O mais estranho é que eles quase não trocaram palavra nenhuma. Eu não entendo como deu tudo tão certo... Será que o Grande Mestre conhece alguma linguagem corporal de hilichurl que eu não conheço?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "Acho que aquilo não foi \"comunicação\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "Aff, não é disso que se trata! Enfim, onde ele está agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "Bem ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "Por fim, está pronto! O melhor vinho de todo Teyvat... Bem aqui, nas minhas mãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "Varka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "Ah, ei, pessoal! Até que enfim chegaram! Esses hilichurls agora há pouco foram surpreendentemente razoáveis... Não esperava que isso fosse dar nem metade tão certo, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "Enfim, hora de descobrir o gosto dessa belezinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "...Espera, não bebe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "Hã? Quer provar primeiro? Hehe, nem pensar, garoto... A honra do primeiro gole é minha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "Não é isso que eu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "Não se preocupa! Vou deixar um pouco para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "*Glup Glup* Ahhh... Hrrgh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "Pera aí... Por que eu estou me sentindo... tão mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "Varka! Você está bem? Varka? Varkaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "Grande Mestre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Vamos! Você não derrotou um deus para morrer aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Ugh... Agh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "...Por um momento, eu poderia jurar que vi todos os Cavaleiros de Boreas anteriores bem aqui, na minha frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "Não sei se eu deveria te dar uma bronca por acabar assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "De qualquer forma, preciso de um momento para digerir tudo... tanto a bebida quanto a lição também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Você explica para Varka o resumo do dom infalível de Diona de preparar bebidas.\\n\"Em outras palavras\", você diz a ele, \"só ela conseguiria transformar ingredientes tão estranhos em uma bebida de primeira...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Aha, então o ingrediente que faltava era, na verdade, a bênção da fada da fonte... Haha, nunca teria adivinhado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "Ei, não faça essa cara de inocente! Você ainda nos deve uma por tentar nos enganar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Desculpa, desculpa... A verdade é que eu realmente acreditava que ia dar certo, e eu até planejava contar toda a verdade depois, tomando uma ou duas bebidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Mas acho que... você provavelmente não quer mais beber isso, quer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Acho que... vou passar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Hmm... Bem, acho que estou em dívida com vocês! Que tal assim, eu pago uma refeição no Caçador de Cervos assim que voltarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "Agora sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Você é fácil demais de subornar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "Ah, qual é! Você viu em que estado ele ficou depois de virar aquele copo. Paimon tem certeza de que ele aprendeu a lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "*Suspiro* Acho que só tenho a mim mesmo para culpar, né...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Eeeenfim... Voltando ao assunto da sua \"tarefa\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Haha, bem... Eu ia guardar essa história para a taverna, mas acho que ao ar livre vai ter que servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "...Então você está dando \"tarefas\" para todo mundo em Mondstadt, é? Ideia interessante... Eu também ganho uma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740944,
					"content": "Hehe... Bem, se você insiste em saber, a sua era \"mudar o destino refletido no Hydroprofetizador\". Mas você já fez isso há um bom tempo, mais precisamente no momento em que decidiu partir na sua expedição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700740941,
					"content": "Por que está em branco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "Não sei se eu tenho essa coragem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "Ou me admirar por você ainda estar de pé...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "Vamos, cara, se controla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "Pelo menos, não em nenhuma linguagem reconhecível, corporal ou não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
