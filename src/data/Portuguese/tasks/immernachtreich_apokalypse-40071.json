			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narração",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "\"Apesar dessa verdade ter sido esquecida pelo povo, estudiosos há muito tempo sabem que a Princesa Fischl von Luftschloss Narfidort desceu nesse mundo durante a Era de Caos, cerca de seiscentos anos antes da Era dos Santos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Narração"
				},
				{
					"id": 400710302,
					"content": "Sério isso? Um narrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Realmente estamos dentro de um livro. Tem até um narrador contando a história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Oh, não, o caminho está destruído, não podemos seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Há um dispositivo ali, parece que está esperando que nos aproximemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "É impressão de Paimon, ou parece que tudo nesse lugar é muito deliberado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Bem, estamos na terra sagrada, o que você esperava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Sim, é tudo tão óbvio... Está implorando para que seja reparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "Ah, essa é nossa Fischl, tão franca... Vejam só esse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "Socorro! Por favor, me ajudem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711002,
					"content": "Hã? Isso não era uma estátua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "Por favor, não fale de mim assim! Me chamo Leon, sou um cavaleiro do Reino da Noite Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711004,
					"content": "Cavaleiro? Não parece nem um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "Não? Bem, não importa. Por favor não falem mal do Sr. Ozvaldo. Ele pessoalmente desenhou e distribuiu a armadura para os Cavaleiros Corvos Noturnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711006,
					"content": "Senhor Ozvaldo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}, você deve ter ouvido isso antes, não? É o nome completo de Oz, \"Ozvaldo Hrafnavines\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "Eu sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Ainda é melhor que Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "Concordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Haha, parece que sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Queridos amigos, perdoem a interrupção, mas creio que vocês não foram informados que o portão em frente está fechado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711014,
					"content": "Não sabíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "Eu espero que vocês possam me salvar, em troca, eu lhes ensinarei como abrir esse portão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711016,
					"content": "Bem, se é assim, temos que salvá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Agora eu sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
		{
