			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "#Você está acordad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710202,
					"content": "Argh... Já amanheceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "O que foi? Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "Pode parecer difícil de acreditar, mas nada aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710205,
					"content": "Você acordou? Ótimo, vamos direto ao ponto: procuramos por todo lado, e não encontramos nada fora do comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710206,
					"content": "De acordo com as regras das duas miragens anteriores, deveríamos ter encontrado algo que servisse como uma entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710207,
					"content": "Isso é estranho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Será que ainda não chegou a hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710209,
					"content": "Você quer dizer que devemos esperar mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710210,
					"content": "Sim. Além disso, não encontramos Fischl em lugar nenhum. Eu suspeito que ela está mais determinada do que nós a encontrar a entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710211,
					"content": "Por isso, esperemos. Vamos dar mais tempo à miragem... Não, a Fischl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710212,
					"content": "Todos concordaram com Mona e descansam. Depois, continuam a busca em dois grupos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "Após numerosas buscas sem sucesso, algo finalmente aparece na praia.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "Tem algo na praia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710215,
					"content": "Um livro? E do lado dele... A estátua de um corvo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710216,
					"content": "Esta estátua parece o Oz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710217,
					"content": "Por que apareceram juntos? Será que o corvo trouxe o livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710218,
					"content": "Que livro é esse? É um diário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710219,
					"content": "Deixe-me ver... \"Canto da Terra Sagrada\"? Nunca vi um livro com esse título.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710220,
					"content": "Pela capa, parece... Que foi escrito por Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710221,
					"content": "Parece o estilo dela. \"Canto da Terra Sagrada\"... Gostei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710222,
					"content": "O título do livro possui um toque de sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710223,
					"content": "O que faremos? Tocamos nele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710224,
					"content": "... Fischl ainda não voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710225,
					"content": "Não importa, vamos entrar na miragem. Quando Fischl encontrar o livro, ela vai nos alcançar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710226,
					"content": "Paimon concorda! É como dar uma espiada no diário dela, ela com certeza vai entrar para nos impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
