				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Oh, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Espere, por que voltamos? Não terminamos a história ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "É uma sensação tão ruim como comprar um manual astrológico falso, ou perceber que você esqueceu sua carteira no meio de um jantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "Ah...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Argh! Isso é horrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "As duas parecem devastadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Para ser honesto, eu também não gosto de ler livros que lhe deixam em um suspense inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, quem gosta disso? Vamos entrar na miragem novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Boa ideia! Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "Ainda estamos aqui, não está funcionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "Que estranho. Nós conseguíamos entrar antes, mas agora não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Por quê?! Por que está nos impedindo terminar o livro?! Isso é sadismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Hmm... Talvez seja porque já chegamos no fim desse livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "Antes de sairmos da miragem, vimos que o livro estava na última página. Creio que \"Canto da Terra Sagrada\" é dividido em vários volumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "É como se fosse um dos esquemas de marketing das light novels... \"Se você quer saber o que acontece a seguir, compre o próximo volume\", argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Hunf! Eu tenho que ler o final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Oh, oh, sim, o final. Todos querem ver como o livro termina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Hã? Quem está aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, pelos Sete, ela me viu! De pé, vamos, de pé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "Você é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Sou \"Arnold, o Peça-direções\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "Que nome tão específico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Arnold, deixa eu te perguntar uma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "É \"Arnold, o Peça-direções\", não só Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "Arnold, o Peça-direções, deixa eu te perguntar uma coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Sim, senhora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Há outros volumes do \"Canto da Terra Sagrada\"? Onde posso encontrá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Oh, você realmente perguntou à pessoa certa. O \"Canto da Terra Sagrada\" é o livro sagrado do Reino da Noite Eterna, com três volumes no total, e os outros dois volumes estão escondidos em dois lugares altos do castelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Se vocês quiserem encontrar o segundo volume, terão de ir até o andar mais alto da torre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Torre? Aquela dali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Isso mesmo, essa é a torre onde as escrituras sagradas estão guardadas. Se vocês olharem bem a caverna ali, encontrarão uma passagem secreta que levará vocês até a torre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Certo, obrigada, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "É \"Arnold, o Peça-direções\", não só Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Você ainda tem mais perguntas, bela dama? Talvez queira saber minha situação amorosa, ou minha renda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "Não! Tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Vamos ignorar o corvo e seguir em frente! Há uma passagem secreta na caverna que leva diretamente até a torre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Oh, mas senhorita! Você tem certeza que não está interessada em mim? Eu só compartilhei os segredos do Reino da Noite Eterna por causa de sua grande beleza! Senhorita, espere!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}