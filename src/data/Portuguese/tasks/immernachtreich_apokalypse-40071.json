					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Parece que chegamos a um beco sem saída. Só há um livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "O que acabamos de ouvir era a história do livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Então a \"Terra Sagrada\" no título do livro se refere ao Reino da Noite Eterna. Esse livro se refere às conquistas da Princesa pela perspectiva do povo em seu reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "É uma espécie de autobiografia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Estamos na última página do livro, mas a história não parece ter acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "E o resto? Paimon quer saber o que acontece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Acho que teremos que continuar explorando. Quanto a esse livro, espere, tenho uma ideia... Já que acabamos de ler, vamos fechá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
