				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "Hã? Fomos teletransportados de novo, mas não voltamos para a praia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711402,
					"content": "Paimon acha que estamos em algum lugar de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711403,
					"content": "Olá, estimada Rainha do Pecado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711404,
					"content": "Amy, querida, eu fiz Bife e Torrada do Pescador. Venha, coma antes que esfrie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Mãe da Fischl"
				},
				{
					"id": 400711405,
					"content": "Ahem! Mãe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711406,
					"content": "Oh, vejam só, tão esquecida. Ahem! Ó, Princesa dos Pecados, sabes que a hora do almoço aproxima-se?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Mãe da Fischl"
				},
				{
					"id": 400711407,
					"content": "Claro, mãe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711408,
					"content": "Ah, essa vista da janela é fantástica. Princesa, Rainha, vocês se juntariam ao Rei do Pecado para um piquenique real? Aproveitaremos a vista e saborearemos as iguarias concedidas pelos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Pai da Fischl"
				},
				{
					"id": 400711409,
					"content": "Sim, com prazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711412,
					"content": "Uh... Alguém quer dizer algo sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Está bem, eu vou primeiro. \"Amy\" é o nome verdadeiro de Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711415,
					"content": "Parece que sim. As outras duas vozes devem ser de sua mãe e seu pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711416,
					"content": "... Por que vocês estão todos olhando para mim?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711417,
					"content": "Pode ser um pouco presunçoso de minha parte, mas... Seu sobrenome é mesmo Megistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711418,
					"content": "Hunf! Você acha que eu estava brincando? Meu título completo é e sempre foi \"Astrologist Mona Megistus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711419,
					"content": "... Perdão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711420,
					"content": "Você não acha muito longo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711421,
					"content": "Bem, é um caso especial. Apenas gênios merecem títulos assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711422,
					"content": "Bem, não faz sentido algum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711423,
					"content": "Como vocês se sentem sobre tudo que vimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711424,
					"content": "Bem, parece que 'fechar o livro' também é uma forma de mudar essa miragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711425,
					"content": "A família de Fischl é bem legal por estarem dispostos a fingirem com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711426,
					"content": "Eles provavelmente não foram assim para sempre. Isso parece ser uma memória da sua infância. As coisas mudam quando se cresce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711427,
					"content": "Você sabe muito sobre Fischl, Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711428,
					"content": "Bem, sou amiga dela, isso é normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711429,
					"content": "Falando em Fischl, onde ela estará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711430,
					"content": "Aquela voz mencionou que ela estava saindo. Vamos lá para fora, talvez encontremos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
