			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Entendo, entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Irmão, você sabe para que serve esta planta além de poder ser cozinhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "Como eu iria saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "Apenas sei onde pode ser colhida, e se podem ser comidas ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Hmm... Então vou sair e dar uma olhada sozinha, não se preocupe, irmão, vou só colher plantas, não vou chegar perto dos monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "*Suspiro* Desde que você tenha cuidado, está tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Já sei! Hoje volto um pouco mais tarde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Ainda está treinando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "Viajante! Você chegou na hora certa! Estava me preparando para sair para a natureza para observar plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "O Cyrus me disse que os aventureiros costumam dormir na natureza e encontrar comida é uma habilidade muito importante para se tornar um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Por isso decidi sair para observar plantas, e registrar seus pontos de distribuição e características, e memorizá-los pouco a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "Assim, no futuro, quando eu estiver na natureza e precisar de comida, já saberei aquilo que posso ou não comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Mas... não acho que descrevê-las com palavras seja o suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "Viajante, ouvi dizer que você tem uma coisa chamada Aparelho Fotográfico, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "Será que você poderia usar seu Aparelho Fotográfico para me ajudar a registrar o ambiente de crescimento das plantas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Então me ajude a registrar primeiro o ambiente de crescimento da Lótus de Leite, da Lâmpada de Grama, e da Cecília por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Depois, pegue essas três plantas e traga-as para mim. Quero preservá-las como espécimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Imagens documentais do ambiente de crescimento das plantas, espécimes reais de plantas e descrições em texto detalhadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "Minhas \"Notas Sobre Plantas Para Um Aventureiro Amador\" vão ficar muito boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "Bem, conto com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "Nas Águas Termais do Vale Termal deve haver uma grande quantidade de Lótus de Leite, e as Lâmpadas de Grama poderão ser encontradas no Reino dos Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "Quanto às Cecílias... poderá ir no Penhasco das Estrelas para encontrá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Vou continuar minhas próprias observações de plantas em outro lugar enquanto isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Assim que você tiver as fotos, nos encontramos na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Como está indo o seu treinamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
