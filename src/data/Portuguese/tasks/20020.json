			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "Viajante, você está de volta! Como foi? Você conseguiu tirar as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Fotos e amostras, está tudo aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#Uau! Isso foi super rápido! Você é {M#um aventureiro}{F#uma aventureira} bem experiente, hein? Que incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "Muito obrigada, Viajante! Na verdade, que tal isso? Deixe-me preparar uma refeição para agradecer. Eu garanto que vai ficar deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "E então, como está? Delicioso não é? Espero que gostem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Comam enquanto eu vou escrever as notas. Hmm, quanto a essas plantas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Vou perguntar a Jack se ele sabe como preservar espécimes de plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Acho que as Cecilias ficariam melhor em um vaso em algum lugar, em vez de servirem como espécimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
