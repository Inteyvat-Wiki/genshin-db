			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*Suspiro* Que frustrante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Há algo que eu possa fazer para ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Ultimamente estamos com pouco pessoal, eu não descanso há dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "#Viajante, se você não estiver muito ocupad{F#a}{M#o}, você poderia entregar esses medicamentos para os pacientes por aqui? E, a propósito, veja como eles estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Conto com você, pelo amor da Arconte Dendro, preciso muito da ajuda de alguém que não passa o dia inteiro falando \"Que a Arconte Dendro abençoai-vos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ah! Pelo amor da Arconte Dendro... Eu tenho dito muito isso ultimamente, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Você precisa descansar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Impossível. Tem pacientes com casos muito mais graves me esperando em outro lugar, tenho que preparar os medicamentos deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "*Suspiro* Eles certamente vão me perguntar como podem fazer para receber as bênçãos da Arconte Dendro de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "Por favor, Viajante. Preciso muito da ajuda de alguém que consiga fazer algo além de falar da graça da Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Você deve ser {F#uma}{M#um} Viajante, bem-vind{F#a}{M#o} ao Bimarstan, um hospital onde cuidamos do público em geral... Hmm... Espalhando as bênçãos da Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Qualquer pessoa necessitada, independentemente de ser rica ou pobre, pode conseguir ajuda médica aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Mas, graças a isso... Ultimamente temos recebido muitos pacientes, mas não temos mãos o suficiente para atender a todos eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "*Suspiro* Embora a benevolência da Arconte Dendro seja infinita... O nosso orçamento e os recursos humanos não são.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Há pacientes que não estão nem um pouco interessados em seguir ordens médicas, só vêm me perguntar como poderiam receber melhor as bênçãos da Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, bênçãos da Arconte Dendro... Pelo amor dos Sete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Se a Arconte Dendro pudesse realmente distribuir bênçãos, nenhuma dessas pessoas ficariam doentes em primeiro lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "... *Suspiro* Me desculpe, eu não deveria falar assim, não conte a Golshan, se ela descobrir ela vai me dar um sermão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Você não é um crente fiel da Arconte Dendro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Sou sim, você consegue encontrar alguém na cidade de Sumeru que não seja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Mas quanto à palavra \"fiel\", vamos substituí-la por \"bastante racional\", um crente bastante racional, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Ah... Desculpe, tenho certeza que é porque estou muito exausto, só estava desabafando, não leve a sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Algumas pessoas dizem que a cura em si, é uma benção da Arconte Dendro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*Suspiro* Mas, lembre-se que são histórias, certo? Não leve isso tão a sério como alguns de nossos pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Se a Arconte Dendro fosse tão onipotente, daria cogumelos aos pacientes e pronto, eles estariam curados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
