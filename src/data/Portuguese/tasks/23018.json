			"dialogs": [
				{
					"id": 230181601,
					"content": "Você voltou, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Ele disse que já estava há alguns dias sem comer carne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "O que?! Eu disse para ele manter uma dieta um pouco mais leve, não para parar de comer carne por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Será que ele pensa que essa é a melhor forma de receber a benção da Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "Tudo bem... Vou ter que pensar em outro jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "De qualquer forma, obrigado pela sua ajuda. Aqui está sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				}
			]
		},
