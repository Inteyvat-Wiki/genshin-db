						230181803
					]
				},
				{
					"id": 230181803,
					"content": "Como é? Você pode comer carne em uma dieta leve? Os estudiosos da Academia fazem o mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "Se é assim! Estava preocupado que se eu comesse carne, a Arconte Dendro ficaria chateado comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Se até estudiosos fazem o mesmo... Então posso comer carne sem me preocupar, obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
