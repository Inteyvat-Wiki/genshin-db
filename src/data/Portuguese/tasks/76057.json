			"dialogs": [
				{
					"id": 760570101,
					"content": "Que tal uma rodada de times da próxima? Talvez algum tipo de duelo? Ah, são vocês! Boas-vindas ao campo de treinamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "Sobre o campo de treinamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Mais e mais pessoas estão aparecendo nos últimos tempo. Isso é tudo graças a vocês. E claro, as crianças e os Mãos Vazias também fizeram o seu papel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Acho que o campo de treinamento pode ser o lugar perfeito para reuniões. Quando você encontra alguém que não vê há muito tempo, é difícil saber por onde começar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "Sobre os Mãos Vazias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah... Ainda não encontrei nada que funcione melhor do que os alvos para o estofamento da toca das toupeiras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "As crianças e eu tentamos todo tipo de material, mas elas adoram mesmo os alvos. Então, por enquanto, trocar com elas ainda é nossa única opção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Mas a gente meio que dominou a taxa de câmbio, e acabamos tendo um bom lucro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Vou passar aqui de novo outra hora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "#Será bem-vind{M#o}{F#a} a qualquer hora! E lembrem-se, sempre é de graça para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
