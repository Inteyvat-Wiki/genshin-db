			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "Que a Arconte Electro abençoe esta senhora e sua neta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "Eu queria saber — ela tem problemas de vista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Vocês perceberam? Sim. Essa senhora não vê muito bem. Sempre que sobe a montanha, ficamos preocupadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Mas ela nunca quer nos incomodar. Diz que já fez esse caminho por muitos anos, e por isso consegue andar por ele sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Por sorte, existem Sacerdotisas no caminho que podem ajudá-la se for necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Que a Arconte Electro abençoe ela e a sua neta em suas respectivas viagens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
