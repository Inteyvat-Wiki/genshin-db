					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "O ladrão vive em uma <color=#00E1FFFF>ruína</color>? As pessoas de Mondstadt também tem alguns costumes diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010702,
					"content": "Por favor, não tire conclusões precipitadas sobre os hábitos dos moradores de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010703,
					"content": "Parece muito mais provável que seja o trabalho de alguns encrenqueiros não muito amigáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010704,
					"content": "Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Um Hilichurl não roubaria um livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010706,
					"content": "O máximo que eles fariam ser usar um livro para alimentar sua fogueira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010712,
					"content": "É mais provável ser a <color=#00E1FFFF>Ordem do Abismo</color>, depois de tudo, eles são imprevisíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010713,
					"content": "Além disso, há um selo elemental na entrada. Parece que é um rastro deixado pela magia do Feiticeiro do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010714,
					"content": "Um selo? Como você vai quebrá-lo? Será que vamos precisar de muito esforço?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010715,
					"content": "Não se preocupe. Se você acha que uma magia simples como esta pode me impedir de entrar, pensa novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010716,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010717,
					"content": "Vamos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010718,
					"content": "Uau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010719,
					"content": "É assim que a Lisa é quando está cheia de trabalho...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010707,
					"content": "A Ordem do Abismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "Parece que você pode ler a minha mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010709,
					"content": "A Guilda de Aventureiros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Hum... Eles percorrem sempre nas ruínas subterrâneas, do ponto de vista disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010711,
					"content": "Mas os Aventureiros normalmente não pegam os pertences dos outros... Bem, pelo menos não pegam as coisas das pessoas que estão vivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "É o livro da <color=#00E1FFFF>Branca de Neve e os Seis Anões</color>! Paimon lembra deste nome, é este que você estava procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010802,
					"content": "É esse mesmo, ainda bem que não está danificado, senão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010803,
					"content": "Senão o quê? Você está querendo me dizer que tem algum castigo pior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010804,
					"content": "Hehe... No mínimo, eu poderia usar algumas das minhas invenções das aulas de medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010805,
					"content": "Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010806,
					"content": "Então, novamente... Como eu disse, não é de nenhuma seção restrita, por isso permiti que ficasse à disposição dos cidadãos comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010807,
					"content": "E não parece ter nenhuma propriedade elemental especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010808,
					"content": "Pois é... Parece só um livro de história normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010809,
					"content": "Então, por que a Ordem do Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "#(Quanto mistério. Estou muito curios{M#o}{F#a}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "Minhas obrigações terminam aqui como Bibliotecária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010812,
					"content": "Já que este livro despertou o seu interesse, então por que não pega emprestado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010813,
					"content": "Quando que tenho que devolver?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "Por favor, não me puna se eu atrasar a devolução...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "Não há data limite para você. Eu vou registrar você como \"Custódia\" ao invés de \"Emprestador\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010816,
					"content": "Este é um privilégio exclusivo, reservado apenas aos cidadãos de confiança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010817,
					"content": "Privilégio exclusivo? Por que acho que essa é apenas sua maneira sorrateira de descarregar seu trabalho problemático para outra pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010818,
					"content": "Perdão? Você tem alguma queixa sobre o meu trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010819,
					"content": "Não, não!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "Eu vou cuidar bem deste livro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "Ótimo. Você é uma pessoal confiável, queria que você pudesse ser minha assistente pessoal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010822,
					"content": "Meu trabalho está feito. Estou voltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010823,
					"content": "Não se esqueça de passar na biblioteca para se registrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
