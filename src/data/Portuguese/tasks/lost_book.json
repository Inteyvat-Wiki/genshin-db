					"content": "Obrigada, Srta. Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011003,
					"content": "... Mas eu acho que estamos nos esquecendo de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011004,
					"content": "O Guia de Viagem de Teyvat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Olhe aquela prateleira! Não é o <color=#00E1FFFF>Guia de Viagem de Teyvat</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011008,
					"content": "E veja quantas cópias existem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011009,
					"content": "Hehehe... O <color=#00E1FFFF>Guia de Viagem de Teyvat</color> é uma publicação em série. Não é parte da coleção oficial da biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011010,
					"content": "Hum...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011011,
					"content": "Pegue um, como compensação da sua ajuda a Lisa hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011012,
					"content": "Com você ao meu lado, meu trabalho fica menos chato do que o usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011013,
					"content": "Hunf! O Guia de Viagem de Teyvat era apenas uma isca para nós recebermos mais trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011014,
					"content": "Não tinha previsto que algo tão rotineiro nos levaria até tão longe da cidade, muito menos a algumas ruínas subterrâneas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011015,
					"content": "Como compensação, pegue estas lembrancinhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011016,
					"content": "Uau, foi a Lisa que preparou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011017,
					"content": "Era para eu lhe dar na próxima viagem... Deixa para lá, podemos falar sobre isso quando chegar o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011018,
					"content": "*Bocejo*...",
