			"dialogs": [
				{
					"id": 1903203101,
					"content": "*chorando* Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "Qianqian tem um favor para pedir a você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "Eu? Um favor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Aquele exorcista de cabelo azul é tão assustador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "Você pode levá-lo para longe daqui? Ele me deixa com medo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "Você está sendo afetada pelo Psíquico Yang Puro dele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Eu não ousaria chegar perto dele. Sua energia... é tão horrível! Ela pode me fazer desaparecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "Eu não quero desaparecer! Por favor, me ajude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "Eu me pergunto se ele consideraria você um espírito maligno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "Em todo caso, tenho uma ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "Eu vi o exorcista de cabelo azul discutindo com alguém ali agora há pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "Vou afugentar aqueles encrenqueiros, mas você tem que pedir ao exorcista para me deixar ir, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "Você está falando a verdade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "Claro, Qianqian nunca mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "Então, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "Ele tem a última palavra, mas tentarei explicar a situação o melhor que puder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Uh ok. Posso considerar isso como um \"sim\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "Espero que o exorcista de cabelo azul seja uma boa pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "Eu vou ajudá-lo e você vai falar com ele. E depois... você vai me ajudar, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "#Eu posso me livrar deles sozinh{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Sim, mas será complicado. Eu já tenho um plano, você precisa acreditar em mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "Ele tem a última palavra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Não me surpreende que não tenhamos visto você o dia todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Por que eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}