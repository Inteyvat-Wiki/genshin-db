			"dialogs": [
				{
					"id": 761160101,
					"content": "#Olha, se não são noss{M#os}{F#as} amig{M#os}{F#as}, e de Bobik também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Então, o que vocês vão fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Vamos ficar aqui por mais um tempo. Quero dizer, a porta do laboratório de Drzislav foi destruída, então temos que ficar aqui para impedir aqueles vilões de encontrarem o caminho para dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Quando a gente consertar a porta, ou quando Slava voltar, provavelmente vamos fazer como vocês e viajar com Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Então, sobre Drzislav...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Não faço ideia de onde ele possa estar... Mas se você encontrar ele nas suas viagens, digam oi para ele por nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Eu adoraria ficar a noite toda bebendo com ele no Navio-Chefe de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Então como vai Bobik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Ooh, já tá com saudades dele? Não se preocupe, só venha aqui quando estiver livre e você pode brincar com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Tchau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Sim. Não se preocupe, vamos nos encontrar de novo com certeza. Somos melhores amigos juntos para o que der e vier, afinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
}