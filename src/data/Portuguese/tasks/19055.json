			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, minhas desculpas mais uma vez. Sinto muito por não ser honesto com você, mas eu... não tive escolha a não ser agir assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Entendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "Aliás, Kokomi sabe disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "A Vossa Excelência? Digamos que a guerra trouxe muita coisa ruim e nos fez crescer muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Então, ela sabe ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "#Bem... Você não está {M#curioso}{F#curiosa} para saber quem trabalhando na implementação da nova Lei de Mercadorias? Não pode ser a Comissão Kanjou, pois não os beneficia diretamente e não temos nenhum conhecido lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Isso é verdade. É como se uma mão de Arconte de repente viesse em seu socorro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Hahaha, arconte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Algum tempo atrás, foi realizado o Festival Irodori na Ilha Narukami. Sua Alteza Sangonomiya e eu também fomos convidados a participar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Naquela época, eu estava no mercado esperando enquanto Sua Alteza Sangonomiya foi para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
