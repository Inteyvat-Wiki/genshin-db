			"dialogs": [
				{
					"id": 190551701,
					"content": "Ela foi ver a Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Exato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "Ela foi para a Comissão Kanjou para ver a Senhorita Yae — supostamente para a revisão de um livro, mas existiam outras coisas, também. A reunião não foi publicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Assim que ela retornou, tomamos medidas para aumentar o comércio, e logo houve impulso para lançar o novo Projeto de Lei de Mercadorias da Ilha Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "Então, você acha que Sua Alteza Sangonomiya sabe disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
