			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "As informações estavam corretas, quando chegamos aqueles Nobushis ainda estavam dormindo, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Nós pegamos todos eles junto com as mercadorias, olha, estão todos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Eu vou contar... Hmm... Está tudo bem, obrigado pelo seu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Não foi nada demais! É graças ao trabalho árduo de sua caravana mercante que os preços dos grãos na aldeia conseguiram cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "É verdade. Quanto a nós, os veteranos, quem pensaria que as feridas que a guerra nos deixou seriam tão graves? Ainda bem que Todoroki trouxe de volta alguns remédios que salvaram nossas vidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Graças ao apoio dos superiores, as coisas mudaram para melhor. Qual é a situação do estoque na aldeia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Vou confirmar isso esta noite. Partirei amanhã de manhã cedo para pedir instruções ao General Gorou em Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Deixe comigo, Todoroki, a lista já está pronta. Venha conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
