			"dialogs": [
				{
					"id": 190550901,
					"content": "Todoroki, as mercadorias chegaram, por favor, venha e conte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190550902,
					"content": "OK, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Boom... ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190550904,
					"content": "Shhhh! Silêncio, vamos segui-los em segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
