			"dialogs": [
				{
					"id": 240051101,
					"content": "O seu irmão é sempre sério assim? Eu nunca vi ele sorrir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Não no passado, mas ele começou a ficar assim desde que começou a ler com seu pai. Agora, ele está sempre com a cara amarrada, e não sei o que ele tá pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Ugh, isso parece mesmo com meu pai. Minha mãe diz que é como se ele estivesse lutando com alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "Mas ele está lutando com o quê?... Ele brigou com sua mãe ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "Não, eles nunca brigam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Adultos são tão estranhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
