			"dialogs": [
				{
					"id": 240050601,
					"content": "Essas vão servir. Me dê um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis começa a fazer molho de Fruta Bulle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Terminamos! Como eu disse antes, estas batatas fritas fresquinhas são por conta da casa. Vocês podem comer agora, mas cuidado, estão quentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Legal! Provem logo. Elas são sensacionais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Oh, Aurele, não conte isso ao meu pai, ou ele vai me dar bronca de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Heh. Fica tranquila. Em qualquer caso, duvido que o Sr. Delerue esteja tão interessado em batatas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050607,
					"content": "Bem... e eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Pode comer. A minha parte, vocês podem dividir entre si. Eu não gosto de comer batatas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050609,
					"content": "#Hehehe, nesse caso, deixa comigo! Prove também, {M#irmãozão}{F#irmãzona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Ah, certo, tenho que comprar café para o Sr. Delerue mais tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050611,
					"content": "Espere, você não pode fazer isso! Minha mãe proibiu meu pai de beber café há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Toda vez que ele bebe café, ele fica tossindo sem parar no quarto dele. Ele até fica rouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Meu pai disse que ele faz tudo isso pelo trabalho, mas que tipo de trabalho te faz sofrer assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "...Esse é o \"preço\" que ele mencionou por escrever análises excelentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050615,
					"content": "O trabalho de um crítico parece difícil mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
