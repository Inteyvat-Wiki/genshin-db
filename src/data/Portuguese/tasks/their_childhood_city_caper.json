					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Vamos lá, irmão, por aqui! Nós não vimos aquele casarão ainda, vimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Pegue leve, Verut, ou você vai cair de novo. Você também, Lovi. Seu pai disse que você está com a saúde fraca, pode pegar um resfriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "Ugh, seu irmão é um chatão, igual minha mãe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Acha que não sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "Nos encontramos novamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#Oi de novo, {M#Irmãozão}{F#Irmãzona}! Bem, não vamos brincar de esconde-esconde desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Mais precisamente, paramos de brincar... e levamos uma bronca da Srta. Nour também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "Ela é sempre tão séria quando está trabalhando, dando sermões pra todo lado. E eu até dei uns biscoitos pra ela no passado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Bem, que seja, estávamos cansados mesmo. Eu ia levar Verut e Aurele para comer uma comida gostosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Você quer vir também no nosso... uh... Como a gente chama isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Um passeio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "Sim, um passeio! Venha com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Vamos até a praça ali. Quero ver a fonte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Então vá na frente, senhorita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Tudo bem então! Vamos... até a praça primeiro. As fontes lá são bem bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Mostre o caminho então, por gentileza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "O que vocês estão fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
