				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Uau... Eu adoraria pular e pisar na água ou dar um tchibum na fonte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Certeza que isso vai te render uma bronca. Só veja de longe, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050203,
					"content": "Mas se as fontes não são para as pessoas brincarem, por que elas são tão grandes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Elas podem parecer legais, mas se você só puder olhar, então são só poças d'água comuns. Nada demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Essa não é uma fonte qualquer. Meu pai disse que as fontes normais... Espera, como foi mesmo que ele disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "\"O principal propósito dos projetos de embelezamento na Corte de Fontaine é resolver problemas de declaração de impostos de uma maneira flexível.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050207,
					"content": "O Sr. Delerue estava me explicando isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050208,
					"content": "Hah, você até pareceu meu pai. Por isso que ele gosta de você, Aurele. Digo, ele sempre leva aquela pilha de livros com ele quando fala com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Eu não entendi uma palavra disso, mas aposto que meu irmão tá falando alguma coisa negativa de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, vamos achar outro lugar para brincar. Digo, você não tem que estudar hoje, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Beleza, vamos ver outros lugares. Deixa eu pensar... O Pássaro a Vapor ainda deve estar aberto. Vamos para lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
