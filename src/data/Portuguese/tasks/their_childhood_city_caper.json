				]
			},
			"dialogs": [
				{
					"id": 240050401,
					"content": "Sr. Louis! Eu queria umas porções de batatas fritas sabor Fruta Bulle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Ah, se não é Lovi! Receio que minhas Frutas Bulle acabaram hoje. Tinha gente demais no porto, entende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "M-Mas eu te disse há um tempo, não disse? E eu até trouxe uns amigos comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*Suspiro* Perdão. Tinha clientes demais hoje e eu esqueci... Mas eu tenho umas batatas fritas comuns. Por favor, peguem, por conta da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Tudo bem, então. Obrigada, Sr. Louis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Você só está sem Frutas Bulle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Bem, se você tiver algumas, eu poderia fazer um pouco de molho na hora. Eu tenho alguns dos outros condimentos sobrando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "#Oba! Você é show, {M#irmãozão}{F#irmãzona}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Valeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Me desculpe. Parece que sempre te incomodamos de algum jeito sempre que nos encontramos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050412,
					"content": "Não precisa ser tão formal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Tudo bem então. Preciso aprender com você. Sr. Delerue diz que sou sem emoção, o que vai dificultar eu virar um crítico no futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050415,
					"content": "Cof. Esqueça isso. Eu cuido deles. Sobre as Frutas Bulle, contamos com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050413,
					"content": "Não vamos nos desanimar por causa disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Eu posso pegar umas para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
