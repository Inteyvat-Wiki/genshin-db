			"dialogs": [
				{
					"id": 240051201,
					"content": "Perdão por incomodar. Eu vou cuidar deles aqui. Alguém tem que impedir que fujam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051202,
					"content": "Se eu puder virar um crítico para o Pássaro ao Vapor, eu posso ganhar um pouco de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051203,
					"content": "Mas o Sr. Delerue disse que eu quisesse virar um crítico, eu não posso me importar muito com Mora. Senão, eu vou começar a andar pelo caminho errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051204,
					"content": "Mas eu preciso mesmo da Mora... O que eu faço... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		}
