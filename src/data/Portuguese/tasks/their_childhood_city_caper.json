				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Então esse é o Pássaro a Vapor? Não... parece tão especial assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050302,
					"content": "Um lugar bem comum, sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Uau, eles têm mesmo um pássaro máquina aqui! Irado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Né? Meu pai sempre me traz aqui para comprar o jornal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Ele absolutamente ama o Pássaro a Vapor. Na verdade, ele poderia passar o dia todo só lendo o jornal. Às vezes, ele até corta pedaços e cola eles em um livro que ele guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Ele chama elas de \"análises\" e às vezes até lê elas para minha mãe e eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Mas a gente não gosta de ouvir elas. Só dizemos \"é\", e \"oh\", e \"é mesmo?\" e coisas assim, mas ele gosta tanto de ler que não percebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "E o que ele quer dizer com \"análise\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Para simplificar, uma análise é um conjunto de opiniões que o crítico expressa do próprio ponto de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050311,
					"content": "O pai de Lovi, Delerue, é um cientista no Instituto de Pesquisas de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050320,
					"content": "Ao mesmo tempo, ele também é um \"crítico\" que escreve \"análises\" no Pássaro a Vapor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050312,
					"content": "É, e ele ama mesmo suas análises longas de... bem, tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Às vezes, ele pensa em algo enquanto fala e se apressa para o quarto para escrever um rascunho. Ele nem come enquanto isso. Só bebe chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Você pode ganhar Mora só dando sua opinião?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Só isso não te faz um \"crítico\". Você precisa seguir alguns princípios se quiser escrever uma análise que outros reconhecerão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050316,
					"content": "#Hmm... Uh... Verut, {M#irmãozão}{F#irmãzona}, estão com fome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "O Sr. Louis me disse que ele está vendendo batatas fritas com sabor de Fruta Bulle recentemente. Vamos experimentar. Eu pago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Oh... é, claro! Vamos lá, irmão, pare de ficar falando. Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Vocês dois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050303,
					"content": "Não tem nada especial nele mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
