			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "Eu... Eu não entendo, por que nem a fórmula de isca do meu pai funcionou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Não fique triste, pode ter sido culpa do Guarda das Ruínas! Ele deve ter assustado o \"Leviatã Lunar\"! Vamos tentar de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Sim, vamos tentar novamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Vamos deixar isso pra lá por enquanto, estou ficando um pouco cansada. Talvez Nantuk tenha razão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "*Suspiro* Vou dar um passeio por aí, preciso esfriar a cabeça e pensar sobre o que vai acontecer depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Aqui está o seu pagamento. Seja qual for o caso, muito obrigada pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "Parece que a Sra. Kujirai quer ficar sozinha agora, vamos voltar para vê-la mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}