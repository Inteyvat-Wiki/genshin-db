				{
					"id": 740590401,
					"content": "Se a Senhorita Puca puder fornecer um suprimento estável de minério, talvez possamos produzir estes relógios em massa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590402
					],
					"speakerTitle": "Chesil"
				},
				{
