				]
			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "#Ah, são vocês, aquel{M#es}{F#as} que me venderam aquelas gemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "É! Você disse algo sobre transformar elas em acessórios bonitos da última vez que nos encontramos... como está a situação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Paimon mal pode esperar para ver como ficaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Sobre isso... tenho uma notícia ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Eu realmente queria incrustar as gemas em joias, mas o minério é muito duro para ser polido à mão com precisão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "E essa não é nem a pior parte. Quem poderia imaginar que depois de ter sido cortado e polido, o minério perderia todo seu brilho original?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "De qualquer forma, eles não são nem um pouco bons para artesanato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Oh... Paimon não esperava que fosse acabar assim. Nós genuinamente achamos que essas pedras seriam úteis de alguma forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Bom, quanto à utilidade... certamente não são inúteis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Chesil coloca um relógio mecânico no balcão enquanto fala.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Vejam esse novo relógio mecânico. Foi feito usando aquele minério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Eu estava prestes a culpar a mim mesmo por ter julgado mal o minério e estava prestes a jogar tudo fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "Mas um relojoeiro passou por aqui e viu os restos deixados pelas tentativas de processamento. Já que o minério era tão durável, ele levou um pouco com ele e usou para fazer componentes para seus relógios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Fiquei surpreso ao descobrir que graças à grande resistência do minério à abrasão, ele é superior aos materiais tradicionalmente usados para fazer os componentes móveis dos relógios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Mas se forem usados para fazer relógios, as remessas de suprimentos precisariam ser ainda mais confiáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Acho que podemos fazer isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Você conta a Chesil sobre Puca e os veios de minério.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Entendo. Então isso é realmente uma ótima coincidência! O protótipo do relógio foi criado usando o design mais recente à prova d'água no estilo de uma concha — em outras palavras, desde o início ele foi planejado para ser usado por Melusines!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "Nesse caso, você poderia levar esse protótipo para a Srta. Puca e explicar a situação para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Afinal de contas, nunca fiz negócios com Melusines antes... Se a Srta. Puca puder fornecer uma fonte estável de materiais, poderemos criar toda uma nova linha de produção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "No futuro, certamente irei pessoalmente visitá-la! Hmm... seria uma boa ideia implementar a estética Melusine em designs futuros de relógios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Hehe, parece que a Puca também pode se beneficiar com isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Ooh, isso pode ser uma ótima oportunidade para Puca começar sua própria fábrica de gemas! Vamos lá, vamos falar com ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Conto com vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Se você entrar em contato direto com Puca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
